<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="20dp"
    tools:context=".vistas.solicitud.DetalleSolicitudActivity">

    <TextView
        android:id="@+id/txtDetalleTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/detalle_solicitud_titulo"
        android:textColor="@color/primary_blue"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnFinalizarYCalificar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDetalleTitulo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TARJETA CON INFORMACIÓN DE LA SOLICITUD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtDetalleCategoria"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💊 Compra de Medicamentos"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/txtDetallePrioridad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔴 URGENTE"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#D32F2F"
                            android:background="#FFEBEE"
                            android:padding="6dp" />
                    </LinearLayout>

                    <!-- FICHA TÉCNICA DE LA SOLICITUD (TableLayout) -->
                    <TableLayout
                        android:id="@+id/tblFichaSolicitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp">

                        <TableRow android:paddingBottom="4dp">
                            <TextView
                                android:text="Solicitante: "
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                            <TextView
                                android:id="@+id/txtDetalleNombre"
                                android:text="María González (78 años)"
                                android:textColor="@color/text_primary" />
                        </TableRow>

                        <TableRow android:paddingBottom="4dp">
                            <TextView
                                android:text="Contacto: "
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                            <TextView
                                android:id="@+id/txtDetalleTelefono"
                                android:text="+56 9 1234 5678"
                                android:textColor="@color/primary_blue" />
                        </TableRow>

                        <TableRow android:paddingBottom="4dp">
                            <TextView
                                android:text="Ubicación: "
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                            <TextView
                                android:id="@+id/txtDetalleDireccion"
                                android:text="Av. Matta 450, Santiago"
                                android:textColor="@color/text_secondary" />
                        </TableRow>

                        <TableRow>
                            <TextView
                                android:text="Fecha: "
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                            <TextView
                                android:id="@+id/txtDetalleFecha"
                                android:text="31/08/2026 15:30"
                                android:textColor="@color/text_secondary" />
                        </TableRow>
                    </TableLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/txtDetalleDescripcion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&quot;Necesito receta de remedios en la Farmacia Ahumada de Av. Matta.&quot;"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECCIÓN REPORTAR TAREAS Y EVIDENCIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_solicitud_seccion_reporte"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilTareasRealizadas"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/detalle_solicitud_hint_tareas">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtTareasRealizadas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top"
                    android:textSize="16sp"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjuntarFoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/detalle_solicitud_btn_evidencia"
                android:textColor="@color/primary_blue"
                app:strokeColor="@color/primary_blue"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/txtFotoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="📷 Ninguna foto seleccionada aún"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinalizarYCalificar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginBottom="8dp"
        android:text="@string/detalle_solicitud_btn_finalizar"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/secondary_green"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverDetalle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverDetalle"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reg_btn_volver"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>