<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:padding="24dp"
    tools:context=".vistas.voluntario.PerfilVoluntarioActivity">

    <TextView
        android:id="@+id/txtPerfilTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/perfil_titulo"
        android:textColor="@color/primary_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtPerfilSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/perfil_subtitulo"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtPerfilTitulo" />

    <!-- IMAGEN DE PERFIL CIRCULAR Y CAMBIO DE FOTO -->
    <LinearLayout
        android:id="@+id/containerAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtPerfilSubtitulo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgPerfilAvatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces"
            android:padding="12dp"
            android:background="@color/white"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="2dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarFoto"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cambiar foto de perfil"
            android:textSize="14sp"
            android:textColor="@color/primary_blue" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPerfilGuardar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerAvatar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TABLA DE ESTADÍSTICAS (TableLayout + TableRow) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Resumen de Impacto"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_blue"
                android:layout_marginBottom="8dp" />

            <TableLayout
                android:id="@+id/tblEstadisticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*"
                android:background="@color/white"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TableRow
                    android:paddingBottom="8dp">
                    <TextView
                        android:text="Ayudas Atendidas"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:text="Calificación Promedio"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                </TableRow>

                <TableRow
                    android:paddingBottom="12dp">
                    <TextView
                        android:text="12 Solicitudes"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_green" />
                    <TextView
                        android:text="⭐ 4.9 / 5.0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue" />
                </TableRow>

                <TableRow
                    android:paddingBottom="8dp">
                    <TextView
                        android:text="Horas Aportadas"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <TextView
                        android:text="Nivel de Reputación"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                </TableRow>

                <TableRow>
                    <TextView
                        android:text="24 Horas"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />
                    <TextView
                        android:text="🥇 Voluntario Oro"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_blue" />
                </TableRow>
            </TableLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPerfilNombre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/reg_hint_nombre"
                app:startIconDrawable="@android:drawable/ic_menu_edit">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPerfilNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Juan Pérez"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPerfilEmail"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/reg_hint_email"
                app:startIconDrawable="@android:drawable/ic_dialog_email">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPerfilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="voluntario@gmail.com"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPerfilTelefono"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/reg_hint_telefono"
                app:startIconDrawable="@android:drawable/ic_menu_call">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPerfilTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+56 9 8765 4321"
                    android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPerfilComuna"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/perfil_hint_comuna"
                app:startIconDrawable="@android:drawable/ic_menu_mylocation">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtPerfilComuna"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Santiago Centro"
                    android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPerfilGuardar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/perfil_btn_guardar"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/secondary_green"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/btnPerfilCerrarSesion"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPerfilCerrarSesion"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:text="@string/perfil_btn_cerrar_sesion"
        android:textColor="#D32F2F"
        android:textSize="16sp"
        android:textStyle="bold"
        app:strokeColor="#D32F2F"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>